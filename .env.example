# Endpoint do Formspree para o formulário "Solicitar Diagnóstico".
# Crie um formulário em https://formspree.io apontando para contato@factoagencia.com.br
# e cole aqui a URL de endpoint que eles fornecerem (formato: https://formspree.io/f/xxxxxxxx).
# Não é um segredo — é só o endereço público de envio do formulário — mas fica fora do
# código para ser fácil de trocar sem precisar editar arquivos-fonte.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx